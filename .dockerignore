# .dockerignore - Exclude files from Docker build context
# This improves build speed and reduces image size

# Dependencies (will be installed in container)
node_modules/
fastapi_server/venv/

# Build outputs (will be generated in container)
dist/
build/

# Version control
.git/
.gitignore

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
fastapi_server.log

# Python cache
__pycache__/
*.py[cod]
*$py.class
.Python
*.egg-info/
.eggs/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Environment files
.env
.env.local
.env.*.local

# Test coverage
coverage/
.nyc_output/

# Temporary files
*.tmp
*.temp
.clinerules*
.roo*

# Documentation (not needed at runtime)
memory-bank/
cline_docs/
CLAUDE.md
README*.md
*.md
!fastapi_server/requirements.txt

# Local scripts (not needed in container)
run-puppeteer-mcp.sh
start-puppeteer-mcpo.sh
install_fastapi.sh

# PID files
.puppeteer_api_pid
*.pid

# Docker files (avoid recursive includes)
Dockerfile
Dockerfile.*
docker-compose*.yml
.dockerignore

# Plan files
.claude/
